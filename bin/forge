#!/usr/bin/env bash
# usage: forge name <product-dir>          the forge's name
#        forge remote <product-dir>        the remote it pushes to
#        forge <submit|status|remarks|merge> <product-dir> <task-run-dir>
# Runs one operation of the product's forge (docs/forge/forge-contract.md). The forge is named in
# the product's factory.properties, as committed on main; without the file it is `local`.
set -euo pipefail
FACTORY_HOME="$(cd "$(dirname "$0")/.." && pwd)"; export FACTORY_HOME
die() { echo "forge: $*" >&2; exit 2; }
op=${1:-}
case "$op" in
  name|remote) [ $# = 2 ] || die "usage: forge $op <product-dir>" ;;
  submit|status|remarks|merge) [ $# = 3 ] || die "usage: forge $op <product-dir> <task-run-dir>" ;;
  *) die "usage: forge <name|remote> <product-dir> | forge <submit|status|remarks|merge> <product-dir> <task-run-dir>" ;;
esac
PRODUCT="$(cd "$2" && pwd)"

# factory.properties: parsed, never sourced. It is product content, and this runs on the host.
forge=local; remote=origin; n=0
while IFS= read -r line || [ -n "$line" ]; do
  n=$((n + 1)); line=${line%%#*}
  line="${line#"${line%%[![:space:]]*}"}"; line="${line%"${line##*[![:space:]]}"}"
  [ -n "$line" ] || continue
  [[ $line =~ ^([a-z.]+)[[:space:]]*=[[:space:]]*([A-Za-z0-9._-]+)$ ]] \
    || die "factory.properties line $n: expected key=value (letters, digits, . _ -)"
  case "${BASH_REMATCH[1]}" in
    forge)        forge=${BASH_REMATCH[2]} ;;
    forge.remote) remote=${BASH_REMATCH[2]} ;;
    *)            die "factory.properties line $n: unknown key ${BASH_REMATCH[1]}" ;;
  esac
done < <(git -C "$PRODUCT" show main:factory.properties 2>/dev/null || true)
[ -d "$FACTORY_HOME/forges/$forge" ] || die "factory.properties: unknown forge '$forge' (no forges/$forge/)"
case "$op" in name) echo "$forge"; exit 0 ;; remote) echo "$remote"; exit 0 ;; esac

RUNDIR="$(cd "$3" && pwd)"
[ -f "$RUNDIR/worktree" ] || die "$RUNDIR is not a task run dir (no worktree file)"
export PRODUCT RUNDIR FORGE_REMOTE=$remote
exec "$FACTORY_HOME/forges/$forge/$op.sh" "$PRODUCT" "$RUNDIR"
